<Window x:Class="LogiBatteryWidget.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LogiBatteryWidget.App.ViewModels"
        mc:Ignorable="d"
        Title="表示するデバイス"
        Width="320"
        SizeToContent="Height"
        MinHeight="120"
        Background="#FF1C1C1E"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <StackPanel Margin="16">
        <TextBlock Text="表示するデバイスの選択・並べ替え" FontSize="12" Foreground="#FF8E8E93"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DevicePreferenceRowViewModel}">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding Visible}"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />

                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#FFEBEBF0" FontSize="13" Background="Transparent"
                                 BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center" CaretBrush="#FFEBEBF0" />

                        <Button Grid.Column="2" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Background="Transparent" BorderThickness="0" Foreground="#FFB0B0B5"
                                Padding="6" Cursor="Hand" ToolTip="上へ"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />

                        <Button Grid.Column="3" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                Background="Transparent" BorderThickness="0" Foreground="#FFB0B0B5"
                                Padding="6" Cursor="Hand" ToolTip="下へ"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="表示位置" FontSize="12" Foreground="#FF8E8E93"
                   Margin="0,16,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="左上" Margin="0,0,4,4" Padding="0,6"
                    Background="#FF2A2A2C" BorderThickness="0" Foreground="#FFEBEBF0" Cursor="Hand"
                    Command="{Binding MainViewModel.MoveToCornerCommand}"
                    CommandParameter="{x:Static vm:WidgetCorner.TopLeft}" />
            <Button Grid.Row="0" Grid.Column="1" Content="右上" Margin="4,0,0,4" Padding="0,6"
                    Background="#FF2A2A2C" BorderThickness="0" Foreground="#FFEBEBF0" Cursor="Hand"
                    Command="{Binding MainViewModel.MoveToCornerCommand}"
                    CommandParameter="{x:Static vm:WidgetCorner.TopRight}" />
            <Button Grid.Row="1" Grid.Column="0" Content="左下" Margin="0,4,4,0" Padding="0,6"
                    Background="#FF2A2A2C" BorderThickness="0" Foreground="#FFEBEBF0" Cursor="Hand"
                    Command="{Binding MainViewModel.MoveToCornerCommand}"
                    CommandParameter="{x:Static vm:WidgetCorner.BottomLeft}" />
            <Button Grid.Row="1" Grid.Column="1" Content="右下" Margin="4,4,0,0" Padding="0,6"
                    Background="#FF2A2A2C" BorderThickness="0" Foreground="#FFEBEBF0" Cursor="Hand"
                    Command="{Binding MainViewModel.MoveToCornerCommand}"
                    CommandParameter="{x:Static vm:WidgetCorner.BottomRight}" />
        </Grid>
    </StackPanel>
</Window>
