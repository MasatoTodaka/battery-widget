<Window x:Class="LogiBatteryWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiBatteryWidget.App"
        xmlns:vm="clr-namespace:LogiBatteryWidget.App.ViewModels"
        xmlns:conv="clr-namespace:LogiBatteryWidget.App.Converters"
        mc:Ignorable="d"
        Title="Logi Battery Widget"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:PercentageToFillWidthConverter x:Key="PercentageToFillWidthConverter" />
        <conv:BatteryFillColorConverter x:Key="BatteryFillColorConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#E61C1C1E" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource CardStyle}"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="2,0,2,12">
                <TextBlock Text="バッテリー" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFEBEBF0" />
                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        HorizontalAlignment="Right" Padding="4"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FFB0B0B5" Cursor="Hand"
                        Command="{Binding RefreshCommand}"
                        ToolTip="今すぐ更新" />
            </Grid>

            <!-- Empty state -->
            <TextBlock Text="デバイスが見つかりません&#x0a;G HUBが起動しているか確認してください"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Foreground="#FF8E8E93" FontSize="12" TextWrapping="Wrap"
                       Margin="2,4,2,4" />

            <!-- Devices -->
            <ItemsControl ItemsSource="{Binding Devices}"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BatteryDeviceViewModel}">
                        <Grid Margin="2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                       FontFamily="Segoe UI Emoji" FontSize="14"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       Foreground="#FFEBEBF0" FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="4,0,8,0" />

                            <!-- iOS-style battery glyph: outline + fill + nub -->
                            <Grid Grid.Column="2" Width="26" Height="13" VerticalAlignment="Center"
                                  Margin="0,0,4,0">
                                <Border BorderBrush="#FF8E8E93" BorderThickness="1.3" CornerRadius="3" />
                                <Border HorizontalAlignment="Left" Margin="2" Height="7"
                                        CornerRadius="1.5"
                                        Width="{Binding Percentage, Converter={StaticResource PercentageToFillWidthConverter}, ConverterParameter=18}">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource BatteryFillColorConverter}">
                                            <Binding Path="Percentage" />
                                            <Binding Path="IsCharging" />
                                        </MultiBinding>
                                    </Border.Background>
                                </Border>
                                <Border HorizontalAlignment="Right" Margin="0,4,-3,4" Width="2"
                                        Background="#FF8E8E93" CornerRadius="0,1,1,0" />
                            </Grid>

                            <TextBlock Grid.Column="3" Text="{Binding PercentageText}"
                                       Foreground="#FFEBEBF0" FontSize="12"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</Window>
