<Window x:Class="LogiBatteryWidget.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiBatteryWidget.App"
        xmlns:vm="clr-namespace:LogiBatteryWidget.App.ViewModels"
        xmlns:conv="clr-namespace:LogiBatteryWidget.App.Converters"
        xmlns:controls="clr-namespace:LogiBatteryWidget.App.Controls"
        mc:Ignorable="d"
        Title="Logi Battery Widget"
        Width="260"
        SizeToContent="Height"
        WindowStyle="None"
        Background="#FF1C1C1E"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BatteryFillColorConverter x:Key="BatteryFillColorConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#FF1C1C1E" />
            <Setter Property="Padding" Value="16,16,16,10" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource CardStyle}"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <StackPanel>

            <!-- Empty state -->
            <TextBlock Text="デバイスが見つかりません&#x0a;G HUBが起動しているか確認してください"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                       Foreground="#FF8E8E93" FontSize="12" TextWrapping="Wrap"
                       Margin="2,4,2,4" />

            <!-- Devices -->
            <ItemsControl ItemsSource="{Binding Devices}"
                          Visibility="{Binding HasDevices, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BatteryDeviceViewModel}">
                        <Grid Margin="2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- iOS Batteries-widget style ring: muted track + colored progress arc, icon centered inside -->
                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                <controls:RingProgress Percentage="{Binding RingPercentage}"
                                                        RingThickness="4.5"
                                                        TrackBrush="#26FFFFFF"
                                                        RingBrush="{Binding Percentage, Converter={StaticResource BatteryFillColorConverter}}" />
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       Foreground="#FFEBEBF0" FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,2,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</Window>
